# Gradle / build
build/
.gradle/
run/
out/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Windows shortcuts dropped into the repo root while working on the sibling checkouts
*.lnk

# Local
logs/
*.log
# Tool-written备份（批量替换留下的 .bak），工件本身不进版本库。
*.bak

# Local development dependency jars.
# libs/ holds the dev jars build.gradle reaches for (AECS, ModDevMCP, EAE+). Each one is a build
# artifact of its own repository, copied in by hand; the comments beside each dependency say which.
libs/*.jar

# Guide archive unpacked next to the source it duplicates. Kept on disk because the mod jar still ships
# it, but the guide sources under assets/ae2_pattern_disk/ae2guide/ are the ones under version control.
src/main/resources/assets/ae2_pattern_disk.zip

# 本机路径声明：兄弟仓库与 libs jar 的绝对路径索引，换机器要改，不进版本库。
docs/LOCAL_DEPS.md

# 上游源码镜像的分支基线（D:\Temp 下的浅克隆），换机器要改，不进版本库。
docs/LOCAL_CLONES.md

# Pi workflow metadata
plans/
.pi/

# 给视频创作者的兼容清单：只作交付件发出，不入库
/docs/COMPATIBILITY.md

# 本地工具（Qoder 仓库知识库快照），不入库
.qoder/
